# Plantilla commiteable — NO contiene secretos (solo URLs públicas).
# En el VPS se crea MANUAL /srv/infra/inmobitwo/web-inmobitwo/.env.production
# (el workflow lo preserva entre deploys y lo usa como build-args).
NEXT_PUBLIC_API_URL=https://api.inmobitwo.seventwo.tech
NEXT_PUBLIC_MAIN_HOSTS=inmobitwo.seventwo.tech
# Alertas push (apagado por defecto)
NEXT_PUBLIC_PUSH_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
